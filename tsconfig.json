{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["dom", "es2018", "esnext.asynciterable"],
    "module": "esnext",
    "moduleResolution": "node",
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["**/*.spec.ts"]
}
