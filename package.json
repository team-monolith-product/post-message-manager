{
  "name": "@team-monolith/post-message-manager",
  "version": "1.2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "ISC",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:npm && npm run build:browser",
    "build:npm": "tsc",
    "build:browser": "esbuild src/index.ts --bundle --outfile=dist/post-message-manager.js --format=iife --global-name=PostMessageManager --minify",
    "test": "npm run test:typecheck && NODE_OPTIONS=--experimental-vm-modules jest",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "test:browser:serve": "node browser-test/server.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.25.11",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "uid": "^2.0.2"
  }
}
